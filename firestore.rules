rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public traffic observations only. Authenticated collector writes use IAM.
    match /live_traffic/{document} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
    match /traffic_history/{document} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
