rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Google output is live-only. Only reviewed independent summaries are public.
    match /permitted_daily_history/{day} {
      allow get: if true;
      allow list: if request.query.limit <= 31;
      allow create, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
